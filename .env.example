# Any extra contact links, names, information:
# You can use markdown, HTML tags in title, extra, about.
# Warning: do not use multi line values.
# Use HTML '<br>' to start a new line in EXTRA_CONTACT_INFO.
# For example:
# PUBLIC_EXTRA_CONTACT_INFO='[MyNetwork](https://mynetwork/bob)<br>YourNetwork: [Bob](https://yournetwork/bob)<br>Cell: +1234567890<br>Available 24/7. Ask Bob.'
PUBLIC_EXTRA_CONTACT_INFO=''

# Show/hide developers info about DegenRocket network with true/false
PUBLIC_IF_SHOW_DEVELOPERS_INFO=true

# Show/hide categories filter in feed with true/false
PUBLIC_IF_SHOW_CATEGORIES_FILTER=true

# Custom categories (for feed filters and new posts)
# PUBLIC_CATEGORIES="defi,privacy,tech,memes"
PUBLIC_CATEGORIES=""

# Show/hide guest login in web3 modal with true/false
PUBLIC_IF_ALLOW_GUEST_LOGIN=true

# Authors:
# Show/hide auto-generated names like NeonCypherPunk
PUBLIC_ENABLE_AUTO_GENERATED_NAMES=true
PUBLIC_ENABLE_AUTO_GENERATED_NAMES_DICTIONARY_TECH=true

# Feed filters:
# The number of reactions/comments for hot/rising activity filter
PUBLIC_FEED_FILTERS_ACTIVITY_HOT=5
PUBLIC_FEED_FILTERS_ACTIVITY_RISING=3

# Pinned events:
# Spasm IDs of pinned events at the top of the feed
# Example:
# PUBLIC_PINNED_IDS="spasmid01192d1f9994bf436f50841459d0a43c0de13ef4aaa5233827bdfe2ea2bc030d6f"
PUBLIC_PINNED_IDS=""

# Custom colors
# Default theme colors are set in 'tailwind.config.js'.
# You can overwrite them with environment variables below.
# Most likely you only need to change primary colors
# for light/dark themes, example:
# Red
# PUBLIC_COLOR_PRIMARY_LIGHT='#ff0000'
# PUBLIC_COLOR_PRIMARY_DARK='#ff0000'
# Green
# PUBLIC_COLOR_PRIMARY_LIGHT='#00ff00'
# PUBLIC_COLOR_PRIMARY_DARK='#00ff00'
# Blue
# PUBLIC_COLOR_PRIMARY_LIGHT='#0000ff'
# PUBLIC_COLOR_PRIMARY_DARK='#0000ff'
PUBLIC_COLOR_PRIMARY_LIGHT=''
PUBLIC_COLOR_PRIMARY_DARK=''
PUBLIC_COLOR_BASE_LIGHT=''
PUBLIC_COLOR_BASE_DARK=''
PUBLIC_COLOR_SECONDARY_LIGHT=''
PUBLIC_COLOR_SECONDARY_DARK=''
