PUBLIC_COLOR_GREEN_DARK=''
PUBLIC_COLOR_RED_LIGHT=''
PUBLIC_COLOR_RED_DARK=''
PUBLIC_COLOR_ORANGE_LIGHT=''
PUBLIC_COLOR_ORANGE_DARK=''
PUBLIC_COLOR_BLUE_LIGHT=''
PUBLIC_COLOR_BLUE_DARK=''
