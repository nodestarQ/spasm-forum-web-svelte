# ============================================================
# Environment variables (SvelteKit)
#
# Client-exposed config is prefixed with PUBLIC_, because SvelteKit
# only exposes PUBLIC_-prefixed vars to the browser. Values are read
# at runtime via $env/dynamic/public, so pre-built Docker/Podman
# images can still set them at container start.
#
# NOT prefixed (intentionally):
#  - deployment/build vars: FRONTEND_* (ports, pm2), MANIFEST_*
#  - server-only vars: API_URL_DOCKER_SSR
#
# App-config, admin, moderation, and whitelist vars here only control
# whether forms/pages are shown in the frontend. Set the same values
# in your backend .env where relevant.
# ============================================================

PUBLIC_API_URL=http://localhost:5000

# Server-only (never exposed to the browser). Used for SSR requests
# inside Docker to reach the backend via internal DNS, e.g.
# http://spasm-backend:5000, since localhost would point at the
# frontend container itself. Leave empty if not using Docker SSR.
API_URL_DOCKER_SSR=

# Favicon (optional). Defaults: base '/favicon.ico', theme 'default'.
PUBLIC_FAVICON_BASE=
PUBLIC_FAVICON_THEME=

# Default port
# PORT=3000
# Development port
FRONTEND_DEV_PORT=3000
# Staging port
FRONTEND_STAGE_PORT=3000
# Production port
FRONTEND_PROD_PORT=3000
# PM2 settings
FRONTEND_PM2_PROD_NAME='sf-prod-front'
FRONTEND_PM2_STAGE_NAME='sf-stage-front'
# How many instances pm2 should spawn (depends of CPU cores)
# Value: '1', '2', '3',..., 'max' (default: 'max'), e.g.:
# FRONTEND_PM2_PROD_INSTANCES='max'
FRONTEND_PM2_PROD_INSTANCES='1'
FRONTEND_PM2_STAGE_INSTANCES='1'
# Choose mode: cluster/fork
FRONTEND_PM2_PROD_EXEC_MODE='cluster'
FRONTEND_PM2_STAGE_EXEC_MODE='cluster'
# Restart at max memory, e.g.: '1G' or '256M'
FRONTEND_PM2_PROD_MAX_MEMORY_RESTART='1G'
FRONTEND_PM2_STAGE_MAX_MEMORY_RESTART='256M'

# Testing
PUBLIC_USE_MOCKED_DATA_IF_BACKEND_IS_DOWN=false

# Meta
# Deprecated in favor of INTRO_TITLE INTRO_ABOUT for simplicity
# META_APP_NAME='Spasm forum'
# META_TITLE='Spasm forum'
# META_DESCRIPTION='Unplug from slave tech!'

# PWA
MANIFEST_NAME='Spasm'
MANIFEST_SHORT_NAME='Spasm'
MANIFEST_ID='Spasm'

# NOTE: frontend environment variables in this file related to
# app config, admin, moderation, and whitelists only affect
# whether certain forms or pages are shown to a user or not.
# It's important to properly set up the same environment
# variables in your backend .env file.
# App config and admin variables can only be set via .env files,
# while moderators, whitelists, socials, and other theme-related
# variables can be changed on an admin web page (recommended).

# App config
PUBLIC_ENABLE_APP_CONFIG_CHANGES=true
PUBLIC_ENABLE_APP_CONFIG_CHANGES_BY_ADMIN=true

# Admin
PUBLIC_ENABLE_ADMIN=true
# Separate admin addresses with comma, e.g.:
# PUBLIC_ADMINS="0xf8553015220a857eda377a1e903c9e5afb3ac2fa,npub1kwnsd0xwkw03j0d92088vf2a66a9kztsq8ywlp0lrwfwn9yffjqspcmr0z"
PUBLIC_ADMINS=""

# Moderation
PUBLIC_ENABLE_MODERATION=true
# Separate moderator addresses with comma, e.g.:
# PUBLIC_MODERATORS="0xf8553015220a857eda377a1e903c9e5afb3ac2fa,npub1kwnsd0xwkw03j0d92088vf2a66a9kztsq8ywlp0lrwfwn9yffjqspcmr0z"
PUBLIC_MODERATORS=""

# Default intro, contacts, image, buttons
PUBLIC_ENABLE_DEFAULT_HEADER_IMAGE=false
PUBLIC_DEFAULT_HEADER_IMAGE_LINK=""
PUBLIC_ENABLE_DEFAULT_INTRO=true
PUBLIC_ENABLE_DEFAULT_CONTACTS=true
PUBLIC_ENABLE_DEFAULT_BUTTON_PRIMARY=false
PUBLIC_DEFAULT_BUTTON_PRIMARY_TEXT=""
PUBLIC_DEFAULT_BUTTON_PRIMARY_LINK=""
PUBLIC_ENABLE_DEFAULT_BUTTON_SECONDARY=false
PUBLIC_DEFAULT_BUTTON_SECONDARY_TEXT=""
PUBLIC_DEFAULT_BUTTON_SECONDARY_LINK=""

# Custom header image, intro and contacts
PUBLIC_ENABLE_CUSTOM_INTRO=true
PUBLIC_ENABLE_CUSTOM_CONTACTS=true

# Intro
# You can use markdown, HTML tags in title, extra, about.
# Warning: do not use multi line values.
# Use HTML '<br>' to start a new line in INTRO_ABOUT.
# For example:
# PUBLIC_INTRO_ABOUT='Line 1<br>Line 2<br>Line 3 is <strong>bold</strong>'
PUBLIC_INTRO_TITLE='Spasm'
PUBLIC_INTRO_TITLE_EXTRA='forum'
PUBLIC_INTRO_ABOUT='Unplug from slave tech!'

# Placeholders do not support new lines with <br> or \n.
PUBLIC_POST_PLACEHOLDER='(Basic markdown is enabled, but HTML tags are not allowed, so use markdown instead).'

PUBLIC_COMMENT_PLACEHOLDER='(Basic markdown is enabled, but HTML tags are not allowed, so use markdown instead).'

# Show/hide contacts in the intro with true/false
PUBLIC_IF_SHOW_CONTACTS_IN_INTRO=true

# Show/hide the intro tutorial with true/false
PUBLIC_IF_SHOW_INTRO_TUTORIAL=true

# Show/hide latest comments at the home page with true/false
PUBLIC_IF_SHOW_HOME_LATEST_COMMENTS=true

# Menu
PUBLIC_SHOW_NEW_POST_BUTTON_IN_MENU=true

# Enable shortened URLs for web3 actions
PUBLIC_ENABLE_SHORT_URLS_FOR_WEB3_ACTIONS=true
PUBLIC_SHORT_URLS_LENGTH_OF_WEB3_IDS="30"

# Enable various web3 actions with true/false
# web3 actions include Ethereum and Nostr actions
PUBLIC_ENABLE_NEW_WEB3_ACTIONS_ALL=true
PUBLIC_ENABLE_NEW_WEB3_ACTIONS_POST=true
PUBLIC_ENABLE_NEW_WEB3_ACTIONS_REPLY=true
PUBLIC_ENABLE_NEW_WEB3_ACTIONS_REACT=true
PUBLIC_ENABLE_NEW_WEB3_ACTIONS_MODERATE=true

PUBLIC_ENABLE_NEW_NOSTR_ACTIONS_ALL=true
PUBLIC_ENABLE_NEW_ETHEREUM_ACTIONS_ALL=true

# White list
# If a white list is enabled, only whitelisted addresses
# can submit new actions (post, reply, reaction, etc.)
PUBLIC_ENABLE_WHITELIST_FOR_ACTION_POST=false
# Separate whitelisted addresses with comma, e.g.:
# PUBLIC_WHITELISTED_FOR_ACTION_POST="0xf8553015220a857eda377a1e903c9e5afb3ac2fa,npub1kwnsd0xwkw03j0d92088vf2a66a9kztsq8ywlp0lrwfwn9yffjqspcmr0z"
PUBLIC_WHITELISTED_FOR_ACTION_POST=""
PUBLIC_ENABLE_WHITELIST_FOR_ACTION_REPLY=false
PUBLIC_WHITELISTED_FOR_ACTION_REPLY=""
PUBLIC_ENABLE_WHITELIST_FOR_ACTION_REACT=false
PUBLIC_WHITELISTED_FOR_ACTION_REACT=""
# "Other" covers actions beyond post/reply/react (e.g. moderate)
PUBLIC_ENABLE_WHITELIST_FOR_ACTION_OTHER=false
PUBLIC_WHITELISTED_FOR_ACTION_OTHER=""

# Nostr network
# NOTE: enabling interaction with Nostr relays has serious
# privacy implications because clients will establish WebSocket
# connections with multiple default relays and then potentially
# with preferred relays, which will be able to log the IP
# addresses of the users and the data they requested.
# Enabling the display of Nostr profile pictures has extra
# privacy and security implications since images are downloaded
# from third party websites, CDNs.
PUBLIC_ENABLE_NOSTR_NETWORK=true
# Fetch data from Nostr relays:
PUBLIC_ENABLE_NOSTR_NETWORK_FETCH_PROFILES=true
PUBLIC_ENABLE_NOSTR_NETWORK_FETCH_PREFERRED_RELAYS=true
PUBLIC_ENABLE_NOSTR_NETWORK_FETCH_MESSAGES=true
# Use Nostr network:
PUBLIC_ENABLE_NOSTR_NETWORK_USE_PREFERRED_RELAYS=true
# Display Nostr data:
PUBLIC_ENABLE_NOSTR_DISPLAY_PROFILES_USERNAMES=true
PUBLIC_ENABLE_NOSTR_DISPLAY_PROFILES_ABOUTS=true
PUBLIC_ENABLE_NOSTR_DISPLAY_PROFILES_WEBSITES=true
PUBLIC_ENABLE_NOSTR_DISPLAY_PROFILES_PICTURES=true
PUBLIC_ENABLE_NOSTR_DISPLAY_PROFILES_MESSAGES=true
# (Optional) specify custom default relays,
# separate relays with comma, example:
# PUBLIC_NOSTR_DEFAULT_RELAYS="wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://relay.nostr.band"
PUBLIC_NOSTR_DEFAULT_RELAYS="wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net,wss://relay.nostr.band"

# Enable markdown in posts with true/false
PUBLIC_ENABLE_MARKDOWN_IN_POSTS=true

# Enable markdown in comments with true/false
PUBLIC_ENABLE_MARKDOWN_IN_COMMENTS=true

# Enable image embedding by wrapping image links with HTML tags
PUBLIC_ENABLE_EMBED_IMAGE_TAGS_FOR_ALL_USERS=true
PUBLIC_ENABLE_EMBED_IMAGE_TAGS_FOR_FULL_LINE_IMAGE_LINKS=true
PUBLIC_ENABLE_EMBED_IMAGE_TAGS_IN_POSTS=true
PUBLIC_ENABLE_EMBED_IMAGE_TAGS_IN_COMMENTS=true

# Enable video embedding by wrapping video links with HTML tags
PUBLIC_ENABLE_EMBED_VIDEO_TAGS_FOR_ALL_USERS=true
PUBLIC_ENABLE_EMBED_VIDEO_TAGS_FOR_FULL_LINE_VIDEO_LINKS=true
PUBLIC_ENABLE_EMBED_VIDEO_TAGS_IN_POSTS=true
PUBLIC_ENABLE_EMBED_VIDEO_TAGS_IN_COMMENTS=true

# Enable audio embedding by wrapping audio links with HTML tags
PUBLIC_ENABLE_EMBED_AUDIO_TAGS_FOR_ALL_USERS=true
PUBLIC_ENABLE_EMBED_AUDIO_TAGS_FOR_FULL_LINE_AUDIO_LINKS=true
PUBLIC_ENABLE_EMBED_AUDIO_TAGS_IN_POSTS=true
PUBLIC_ENABLE_EMBED_AUDIO_TAGS_IN_COMMENTS=true

# Allow video embedding via iframe tags
# WARNING: potential security vulnerability,
# so use with caution. Only allow to trusted
# signers with good security practices.
# If a signer leaks a private key, it can be
# potentially used to exploit the app by serving
# malicious code via the iframe tags.
# Default: false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_FOR_SELECTED_USERS=false
# Inline links can be embedded within text on the same line
# or formatted as markdown, unlike a full-line link
# which spans the entire line.
# Examples inline links:
# Website: https://spasm.network
# Visit our [website](https://spasm.network) today!
# Example a full-line link:
# https://spasm.network
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_FOR_INLINE_LINKS=false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_FOR_VIDEOS=false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_FOR_IMAGES=false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_FOR_AUDIO=false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_IN_POSTS=false
PUBLIC_ENABLE_EMBED_IFRAME_TAGS_IN_COMMENTS=false
# Whitelist signers for iframe tags
# Separate eligible signers with comma, e.g.:
# PUBLIC_SIGNERS_ALLOWED_TO_EMBED_IFRAME_TAGS="0x56bc5fcf4922d8dc29adc8567b6221ff26ff7ae8,0x4e94cc43fb152ac12d3f45d7dd420f794a9e6205"
PUBLIC_SIGNERS_ALLOWED_TO_EMBED_IFRAME_TAGS=""
# Additional security check.
# Provide domains that can embed videos with iframe tags.
# Separate whitelisted domains with comma.
# For security reasons specify full domain names with '/' at the end.
# If you set "https://video.com" without '/' at the end, then
# a malicious whitelisted signer will be able to add iframe tags
# from the following domain "https://video.communityhacker.io".
# To allow all domains, type whitelisted protocols "https,ipfs".
# Example:
# PUBLIC_IFRAME_TAGS_ALLOWED_DOMAINS="https://iframe.mediadelivery.net/embed/,https://youtube.com/embed/,https://www.youtube.com/embed/"
PUBLIC_IFRAME_TAGS_ALLOWED_DOMAINS=""
PUBLIC_IFRAME_TAGS_ALLOWED_DOMAINS_ANY=false
PUBLIC_IFRAME_VIDEO_WIDTH="640"
PUBLIC_IFRAME_VIDEO_HEIGHT="520"
# Separate additional params with empty space.
# Add 'allowfullscreen' to allow full screen, e.g.:
# PUBLIC_IFRAME_ADDITIONAL_PARAMS="allowfullscreen"
PUBLIC_IFRAME_ADDITIONAL_PARAMS="allowfullscreen"
# Hide standalone URL if it takes up the whole line with true/false.
PUBLIC_IFRAME_HIDE_ONE_LINE_URL=true

# Default explorers to Ethereum/Nostr addresses
# The URL should contain a full path, e.g.:
# PUBLIC_DEFAULT_EXPLORER_ETHEREUM_ADDRESS='https://example.com/address/'
# PUBLIC_DEFAULT_EXPLORER_NOSTR_ADDRESS='https://example.com/@'
PUBLIC_DEFAULT_EXPLORER_ETHEREUM_ADDRESS='https://etherscan.io/address/'
PUBLIC_DEFAULT_EXPLORER_NOSTR_ADDRESS='https://primal.net/p/'

# Another website links:
PUBLIC_ANOTHER_WEBSITE_LINK=''
PUBLIC_TOR_LINK=''
PUBLIC_IPFS_LINK=''
PUBLIC_IPFS_HTTP_GATEWAY_LINK=''

